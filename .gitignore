## .gitignore para projetos .NET / C# / Visual Studio

# Build and Output
bin/
obj/
out/
publish/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs & temp
*.log
*.tmp
TestResults/

# Banco de dados SQLite (nunca versionar)
*.db
*.db-shm
*.db-wal

# Segredos / configs locais
.env
.env.*

# OS Specific
.DS_Store
Thumbs.db
